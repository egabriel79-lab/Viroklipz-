{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "if [ ! -d /tmp/flutter ]; then git clone https://github.com/flutter/flutter.git -b stable --depth 1 /tmp/flutter; fi",
  "buildCommand": "/tmp/flutter/bin/flutter --suppress-analytics config --enable-web && /tmp/flutter/bin/flutter pub get && /tmp/flutter/bin/flutter build web --release",
  "outputDirectory": "build/web",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
