rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && (
        request.auth.token.email_verified == true
        || ('firebase' in request.auth.token && request.auth.token.firebase.sign_in_provider == 'password')
      );
    }

    function isBootstrappedOwner() {
      return isVerified()
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['Egabriel79@gmail.com', 'egabriel79@gmail.com'];
    }

    function isAdmin() {
      return isBootstrappedOwner()
        || (isVerified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)))
        || (
          isVerified()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && 'isAdmin' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
        );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUsername(u) {
      return u is string && u.size() >= 3 && u.size() <= 24 && u.matches('^[a-z0-9._]{3,24}$');
    }

    function isStarterClipId(clipId) {
      return clipId in [
        'clip_urban_dance',
        'clip_rooftop_dj',
        'clip_latte_craft',
        'clip_alpine_trail',
        'clip_synth_studio'
      ];
    }

    function isValidChatRoom(roomId) {
      return roomId in ['general', 'musica', 'baile', 'cocina'];
    }

    function isOfficialViroklipzUserDoc(data) {
      return data.username == 'viroklipz'
        || ('email' in data && data.email in ['Egabriel79@gmail.com', 'egabriel79@gmail.com']);
    }

    function prevRealFollowers(data) {
      return ('realFollowersCount' in data)
        ? data.realFollowersCount
        : (isOfficialViroklipzUserDoc(data) ? 0 : (('followersCount' in data) ? data.followersCount : 0));
    }

    function isValidFollowerBreakdown(data, realCount) {
      return 'realFollowersCount' in data
        && 'seededFollowersCount' in data
        && 'followersCount' in data
        && data.realFollowersCount == realCount
        && (
          (
            isOfficialViroklipzUserDoc(data)
            && data.seededFollowersCount == (realCount >= 2000 ? 0 : 2000 - realCount)
            && data.followersCount == (realCount >= 2000 ? realCount : 2000)
          )
          ||
          (
            !isOfficialViroklipzUserDoc(data)
            && data.seededFollowersCount == 0
            && data.followersCount == realCount
          )
        );
    }

    // --- Validation Blueprints ---
    function isValidGuardianData(g) {
      return g is map
        && g.keys().hasAll(['name', 'surname', 'id', 'authorized'])
        && g.keys().hasOnly(['name', 'surname', 'id', 'authorized'])
        && g.name is string && g.name.size() >= 1 && g.name.size() <= 60
        && g.surname is string && g.surname.size() >= 1 && g.surname.size() <= 60
        && g.id is string && g.id.size() >= 3 && g.id.size() <= 32
        && g.authorized is bool && g.authorized == true;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid', 'username', 'displayName', 'bio', 'avatarUrl', 'isPublic', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'username', 'displayName', 'bio', 'bioColor', 'personalLink', 'pronouns', 'avatarUrl', 'isPublic', 'fcmToken', 'fcmTokenWeb', 'presenceStatus', 'mutedCommunityChat', 'fanLevel', 'fanPoints', 'banned', 'isBanned', 'isAdmin', 'isVerified', 'coins', 'freeRoses', 'welcomeRechargeClaimed', 'followersCount', 'realFollowersCount', 'seededFollowersCount', 'country', 'email', 'age', 'isMinor', 'guardianData', 'createdAt', 'updatedAt'
        ])
        && data.uid == userId
        && isValidUsername(data.username)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 40
        && data.bio is string && data.bio.size() <= 160
        && (!('bioColor' in data) || (data.bioColor is string && data.bioColor.size() <= 16))
        && (!('personalLink' in data) || (data.personalLink is string && data.personalLink.size() <= 160))
        && (!('pronouns' in data) || (data.pronouns is string && data.pronouns.size() <= 32))
        && data.avatarUrl is string && data.avatarUrl.size() <= 300
        && data.isPublic is bool
        && (!('fcmToken' in data) || (data.fcmToken is string && data.fcmToken.size() <= 512))
        && (!('fcmTokenWeb' in data) || (data.fcmTokenWeb is string && data.fcmTokenWeb.size() <= 512))
        && (!('presenceStatus' in data) || data.presenceStatus in ['online', 'busy', 'hidden'])
        && (!('mutedCommunityChat' in data) || data.mutedCommunityChat is bool)
        && (!('fanLevel' in data) || (data.fanLevel is int && data.fanLevel >= 1 && data.fanLevel <= 50))
        && (!('fanPoints' in data) || (data.fanPoints is int && data.fanPoints >= 0 && data.fanPoints <= 10000000))
        && (!('banned' in data) || data.banned is bool)
        && (!('isBanned' in data) || data.isBanned is bool)
        && (!('isAdmin' in data) || data.isAdmin is bool)
        && (!('isVerified' in data) || data.isVerified is bool)
        && (!('coins' in data) || (data.coins is int && data.coins >= 0 && data.coins <= 100000000))
        && (!('freeRoses' in data) || (data.freeRoses is int && data.freeRoses >= 0 && data.freeRoses <= 10000))
        && (!('welcomeRechargeClaimed' in data) || data.welcomeRechargeClaimed is bool)
        && (!('followersCount' in data) || (data.followersCount is int && data.followersCount >= 0 && data.followersCount <= 100000000))
        && (!('realFollowersCount' in data) || (data.realFollowersCount is int && data.realFollowersCount >= 0 && data.realFollowersCount <= 100000000))
        && (!('seededFollowersCount' in data) || (data.seededFollowersCount is int && data.seededFollowersCount >= 0 && data.seededFollowersCount <= 2000))
        && (!('country' in data) || (data.country is string && data.country.size() <= 64))
        && (!('email' in data) || (data.email is string && data.email.size() <= 120))
        && (!('age' in data) || (data.age is int && data.age >= 1 && data.age <= 120))
        && (!('isMinor' in data) || data.isMinor is bool)
        && (!('guardianData' in data) || isValidGuardianData(data.guardianData))
        && (!('isMinor' in data) || data.isMinor == false || ('guardianData' in data && isValidGuardianData(data.guardianData)))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPrivateInfo(data, userId) {
      return data.keys().hasAll(['uid', 'firstName', 'lastName', 'phone', 'email', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'firstName', 'lastName', 'phone', 'email', 'updatedAt'])
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.firstName is string && data.firstName.size() <= 40
        && data.lastName is string && data.lastName.size() <= 40
        && data.phone is string && data.phone.size() <= 24
        && data.email is string && data.email.size() <= 120
        && data.updatedAt is timestamp;
    }

    function isValidUserStreak(data, userId) {
      return data.keys().hasAll(['uid', 'currentStreak', 'longestStreak', 'lastActiveDate', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'currentStreak', 'longestStreak', 'lastActiveDate', 'updatedAt'])
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.currentStreak is int && data.currentStreak >= 0 && data.currentStreak <= 10000
        && data.longestStreak is int && data.longestStreak >= data.currentStreak && data.longestStreak <= 10000
        && data.lastActiveDate is string && data.lastActiveDate.size() == 10
        && data.lastActiveDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.updatedAt is timestamp;
    }

    function isValidUserReaction(data, userId, clipId) {
      return data.keys().hasAll(['userId', 'clipId', 'createdAt'])
        && data.keys().hasOnly(['userId', 'clipId', 'createdAt'])
        && data.userId == userId
        && data.userId == request.auth.uid
        && data.clipId == clipId
        && isValidId(data.clipId)
        && data.createdAt == request.time;
    }

    function isValidUserFollow(data, userId, targetId) {
      return data.keys().hasAll(['followerId', 'targetId', 'targetUsername', 'createdAt'])
        && data.keys().hasOnly(['followerId', 'targetId', 'targetUsername', 'createdAt'])
        && data.followerId == userId
        && data.followerId == request.auth.uid
        && data.targetId == targetId
        && data.targetId != userId
        && isValidId(data.targetId)
        && isValidUsername(data.targetUsername)
        && data.createdAt == request.time;
    }

    function isValidUserBlock(data, userId, targetId) {
      return data.keys().hasAll(['blockerId', 'targetId', 'targetUsername', 'createdAt'])
        && data.keys().hasOnly(['blockerId', 'targetId', 'targetUsername', 'createdAt'])
        && data.blockerId == userId
        && data.blockerId == request.auth.uid
        && data.targetId == targetId
        && data.targetId != userId
        && isValidId(data.targetId)
        && isValidUsername(data.targetUsername)
        && data.createdAt == request.time;
    }

    function isValidReport(data, reportId) {
      return data.keys().hasAll([
          'id', 'reporterId', 'targetType', 'targetId', 'targetAuthorId', 'reason', 'details', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'reporterId', 'reporterUid', 'targetType', 'targetId', 'videoId', 'targetAuthorId', 'reason', 'details', 'status', 'reviewedBy', 'reviewedAt', 'createdAt'
        ])
        && data.id == reportId
        && isValidId(data.id)
        && isValidId(data.reporterId)
        && (!('reporterUid' in data) || data.reporterUid == data.reporterId)
        && data.targetType in ['clip', 'chat_message', 'user']
        && isValidId(data.targetId)
        && (!('videoId' in data) || isValidId(data.videoId))
        && isValidId(data.targetAuthorId)
        && data.reason in ['spam', 'acoso', 'contenido_inapropiado', 'desnudo', 'derechos_autor']
        && data.details is string && data.details.size() <= 240
        && (!('status' in data) || data.status in ['pending', 'resolved', 'dismissed'])
        && (!('reviewedBy' in data) || isValidId(data.reviewedBy))
        && (!('reviewedAt' in data) || data.reviewedAt is timestamp)
        && data.createdAt is timestamp;
    }

    function isValidHashtags(tags) {
      return tags is list
        && tags.size() <= 8
        && (tags.size() == 0 || (tags[0] is string && tags[0].size() >= 1 && tags[0].size() <= 32));
    }

    function isValidClip(data, clipId) {
      return data.keys().hasAll([
          'id', 'authorId', 'authorUsername', 'authorDisplayName', 'authorAvatarUrl',
          'caption', 'category', 'hashtags', 'audioTitle', 'audioPreset',
          'visualPreset', 'durationSec', 'hasLocalMedia', 'visibility',
          'likesCount', 'sharesCount', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'authorId', 'authorUsername', 'authorDisplayName', 'authorAvatarUrl',
          'caption', 'category', 'hashtags', 'audioTitle', 'audioPreset',
          'visualPreset', 'videoUrl', 'mediaType', 'durationSec', 'hasLocalMedia', 'visibility',
          'likesCount', 'bookmarksCount', 'viewsCount', 'sharesCount', 'replaysCount', 'createdAt', 'updatedAt'
        ])
        && data.id == clipId
        && isValidId(data.id)
        && isValidId(data.authorId)
        && isValidUsername(data.authorUsername)
        && data.authorDisplayName is string && data.authorDisplayName.size() >= 1 && data.authorDisplayName.size() <= 40
        && data.authorAvatarUrl is string && data.authorAvatarUrl.size() <= 300
        && data.caption is string && data.caption.size() <= 1000
        && data.category is string && data.category.size() <= 60
        && isValidHashtags(data.hashtags)
        && data.audioTitle is string && data.audioTitle.size() <= 80
        && data.audioPreset is string && data.audioPreset.size() <= 80
        && data.visualPreset is string && data.visualPreset.size() >= 1 && data.visualPreset.size() <= 120
        && (!('videoUrl' in data) || (data.videoUrl is string && data.videoUrl.size() <= 300 && (data.videoUrl.size() == 0 || data.videoUrl.matches('^https://.*'))))
        && (!('mediaType' in data) || data.mediaType == 'video')
        && data.durationSec is number && data.durationSec >= 3 && data.durationSec <= 60
        && data.hasLocalMedia is bool
        && data.visibility in ['public', 'private']
        && data.likesCount is int && data.likesCount >= 0
        && (!('bookmarksCount' in data) || (data.bookmarksCount is int && data.bookmarksCount >= 0))
        && (!('viewsCount' in data) || (data.viewsCount is int && data.viewsCount >= 0))
        && data.sharesCount is int && data.sharesCount >= 0
        && (!('replaysCount' in data) || (data.replaysCount is int && data.replaysCount >= 0))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidComment(data, commentId, clipId) {
      return data.keys().hasAll([
          'id', 'clipId', 'authorId', 'authorUsername', 'authorAvatarUrl', 'text', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'clipId', 'authorId', 'authorUsername', 'authorAvatarUrl', 'text', 'createdAt'
        ])
        && data.id == commentId
        && isValidId(data.id)
        && data.clipId == clipId
        && isValidId(data.clipId)
        && data.authorId == request.auth.uid
        && isValidUsername(data.authorUsername)
        && data.authorAvatarUrl is string && data.authorAvatarUrl.size() <= 300
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 240
        && data.createdAt == request.time;
    }

    function isValidChatMessage(data, messageId, roomId) {
      return data.keys().hasAll([
          'id', 'roomId', 'authorId', 'authorUsername', 'authorAvatarUrl', 'text', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'roomId', 'authorId', 'authorUsername', 'authorAvatarUrl', 'text', 'createdAt'
        ])
        && data.id == messageId
        && isValidId(data.id)
        && data.roomId == roomId
        && isValidChatRoom(data.roomId)
        && data.authorId == request.auth.uid
        && isValidUsername(data.authorUsername)
        && data.authorAvatarUrl is string && data.authorAvatarUrl.size() <= 300
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 240
        && data.createdAt == request.time;
    }

    function isValidDirectThread(data, threadId) {
      return data.keys().hasAll([
          'id', 'participantIds', 'lastMessageText', 'lastSenderId', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'participantIds', 'lastMessageText', 'lastSenderId', 'streak', 'lastMessageDate', 'createdAt', 'updatedAt'
        ])
        && data.id == threadId
        && isValidId(data.id)
        && data.participantIds is list
        && data.participantIds.size() == 2
        && isValidId(data.participantIds[0])
        && isValidId(data.participantIds[1])
        && data.participantIds[0] != data.participantIds[1]
        && request.auth.uid in data.participantIds
        && data.lastMessageText is string && data.lastMessageText.size() <= 240
        && data.lastSenderId == request.auth.uid
        && (!('streak' in data) || (data.streak is int && data.streak >= 0 && data.streak <= 100000))
        && (!('lastMessageDate' in data) || data.lastMessageDate is timestamp)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isDirectThreadParticipant(threadId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/directThreads/$(threadId))
        && request.auth.uid in get(/databases/$(database)/documents/directThreads/$(threadId)).data.participantIds;
    }

    function isValidDirectMessage(data, messageId, threadId) {
      return data.keys().hasAll([
          'id', 'threadId', 'authorId', 'authorUsername', 'authorAvatarUrl', 'text', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'threadId', 'authorId', 'authorUsername', 'authorAvatarUrl', 'text', 'createdAt'
        ])
        && data.id == messageId
        && isValidId(data.id)
        && data.threadId == threadId
        && isValidId(data.threadId)
        && data.authorId == request.auth.uid
        && isValidUsername(data.authorUsername)
        && data.authorAvatarUrl is string && data.authorAvatarUrl.size() <= 300
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 240
        && data.createdAt == request.time;
    }

    function isValidStatusNote(data, userId) {
      return data.keys().hasAll([
          'uid', 'username', 'displayName', 'avatarUrl', 'note', 'presence', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'username', 'displayName', 'avatarUrl', 'note', 'presence', 'updatedAt'
        ])
        && data.uid == userId
        && data.uid == request.auth.uid
        && isValidUsername(data.username)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 40
        && data.avatarUrl is string && data.avatarUrl.size() <= 300
        && data.note is string && data.note.size() <= 60
        && data.presence in ['online', 'busy', 'hidden']
        && data.updatedAt is timestamp;
    }

    function isValidCommunityChatMessage(data, messageId) {
      return data.keys().hasAll([
          'id', 'roomId', 'authorId', 'authorUsername', 'authorAvatarUrl', 'text', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'roomId', 'authorId', 'authorUsername', 'authorAvatarUrl', 'text', 'createdAt'
        ])
        && data.id == messageId
        && isValidId(data.id)
        && data.roomId == 'community'
        && data.authorId == request.auth.uid
        && isValidUsername(data.authorUsername)
        && data.authorAvatarUrl is string && data.authorAvatarUrl.size() <= 300
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 240
        && data.createdAt == request.time;
    }

    function isValidFanPerks(perks) {
      return perks is list
        && perks.size() <= 12
        && (
          perks.size() == 0
          || (
            perks[0] is map
            && perks[0].id is string
            && perks[0].title is string && perks[0].title.size() >= 1 && perks[0].title.size() <= 60
            && perks[0].minLevel is int && perks[0].minLevel in [1, 10, 20, 30, 40, 50]
          )
        );
    }

    function isValidAudienceFavorites(favs) {
      return favs is list
        && favs.size() <= 12
        && (
          favs.size() == 0
          || (
            favs[0] is map
            && favs[0].id is string
            && favs[0].action is string && favs[0].action.size() >= 1 && favs[0].action.size() <= 80
            && favs[0].giftId is string && favs[0].giftId.size() >= 1 && favs[0].giftId.size() <= 32
            && favs[0].giftName is string && favs[0].giftName.size() >= 1 && favs[0].giftName.size() <= 40
            && favs[0].coins is int && favs[0].coins >= 1 && favs[0].coins <= 100000
          )
        );
    }

    function isValidLiveConfig(data, creatorUid) {
      return data.keys().hasAll(['creatorUid', 'fanPerks', 'audienceFavorites', 'updatedAt'])
        && data.keys().hasOnly([
          'creatorUid', 'fanPerks', 'audienceFavorites',
          'fanClubName', 'fanPointsPerCoin',
          'vipAlertEnabled', 'vipAlertTitle', 'vipAlertStyle', 'vipAlertDurationSec', 'vipAlertSound',
          'updatedAt'
        ])
        && data.creatorUid == creatorUid
        && data.creatorUid == request.auth.uid
        && isValidFanPerks(data.fanPerks)
        && isValidAudienceFavorites(data.audienceFavorites)
        && (!('fanClubName' in data) || (data.fanClubName is string && data.fanClubName.size() <= 36))
        && (!('fanPointsPerCoin' in data) || (data.fanPointsPerCoin is int && data.fanPointsPerCoin >= 1 && data.fanPointsPerCoin <= 20))
        && (!('vipAlertEnabled' in data) || data.vipAlertEnabled is bool)
        && (!('vipAlertTitle' in data) || (data.vipAlertTitle is string && data.vipAlertTitle.size() <= 40))
        && (!('vipAlertStyle' in data) || data.vipAlertStyle in ['crystal_magenta', 'electric_pulse', 'aurora_vip'])
        && (!('vipAlertDurationSec' in data) || (data.vipAlertDurationSec is int && data.vipAlertDurationSec >= 3 && data.vipAlertDurationSec <= 10))
        && (!('vipAlertSound' in data) || data.vipAlertSound is bool)
        && data.updatedAt is timestamp;
    }

    function isValidLiveStream(data, streamId) {
      return data.keys().hasAll([
          'id', 'hostUid', 'hostUsername', 'hostDisplayName', 'hostAvatarUrl',
          'title', 'category', 'previewImageUrl', 'streamUrl', 'audioPreset',
          'status', 'viewerCount', 'likesCount', 'startedAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'hostUid', 'hostUsername', 'hostDisplayName', 'hostAvatarUrl',
          'title', 'about', 'audience', 'quality', 'visualEffect',
          'backgroundPreset', 'commentPermission', 'giftsEnabled', 'noiseCancellation',
          'category', 'previewImageUrl', 'streamUrl', 'guestUid', 'guestDisplayName', 'guestStreamUrl',
          'guests',
          'audioPreset', 'status', 'viewerCount', 'likesCount', 'giftsCount',
          'fanPerks', 'audienceFavorites', 'fanClubName', 'fanPointsPerCoin',
          'vipAlertEnabled', 'vipAlertTitle', 'vipAlertStyle', 'vipAlertDurationSec', 'vipAlertSound',
          'startedAt', 'updatedAt'
        ])
        && data.id == streamId
        && isValidId(data.id)
        && isValidId(data.hostUid)
        && isValidUsername(data.hostUsername)
        && data.hostDisplayName is string && data.hostDisplayName.size() >= 1 && data.hostDisplayName.size() <= 40
        && data.hostAvatarUrl is string && data.hostAvatarUrl.size() <= 300
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 80
        && (!('about' in data) || (data.about is string && data.about.size() <= 240))
        && (!('audience' in data) || data.audience in ['public', 'friends'])
        && (!('quality' in data) || data.quality in ['720p', '1080p'])
        && (!('visualEffect' in data) || (data.visualEffect is string && data.visualEffect.size() <= 32))
        && (!('backgroundPreset' in data) || data.backgroundPreset in ['camera', 'blur', 'studio_magenta', 'studio_blue', 'studio_dark'])
        && (!('commentPermission' in data) || data.commentPermission in ['all', 'followers', 'off'])
        && (!('giftsEnabled' in data) || data.giftsEnabled is bool)
        && (!('noiseCancellation' in data) || data.noiseCancellation is bool)
        && data.category in ['general', 'baile', 'musica', 'cocina', 'deportes', 'arte', 'comedia', 'viajes']
        && data.previewImageUrl is string && data.previewImageUrl.size() <= 300
        && (data.previewImageUrl.size() == 0 || data.previewImageUrl.matches('^(/src/assets/.*|https://.*)$'))
        && data.streamUrl is string && data.streamUrl.size() <= 300
        && (data.streamUrl.size() == 0 || data.streamUrl.matches('^https://.*'))
        && (!('guestUid' in data) || (data.guestUid is string && data.guestUid.size() <= 128))
        && (!('guestDisplayName' in data) || (data.guestDisplayName is string && data.guestDisplayName.size() <= 40))
        && (!('guestStreamUrl' in data) || (data.guestStreamUrl is string && data.guestStreamUrl.size() <= 300 && (data.guestStreamUrl.size() == 0 || data.guestStreamUrl.matches('^https://.*'))))
        && (!('guests' in data) || (data.guests is list && data.guests.size() <= 10 && (data.guests.size() == 0 || data.guests[0] is string)))
        && data.audioPreset in ['urban_beat', 'sunset_house', 'lofi_espresso', 'alpine_rush', 'analog_synth']
        && data.status in ['live', 'ended']
        && data.viewerCount is int && data.viewerCount >= 1 && data.viewerCount <= 1000000
        && data.likesCount is int && data.likesCount >= 0 && data.likesCount <= 100000000
        && (!('giftsCount' in data) || (data.giftsCount is int && data.giftsCount >= 0 && data.giftsCount <= 100000000))
        && (!('fanPerks' in data) || isValidFanPerks(data.fanPerks))
        && (!('audienceFavorites' in data) || isValidAudienceFavorites(data.audienceFavorites))
        && (!('fanClubName' in data) || (data.fanClubName is string && data.fanClubName.size() <= 36))
        && (!('fanPointsPerCoin' in data) || (data.fanPointsPerCoin is int && data.fanPointsPerCoin >= 1 && data.fanPointsPerCoin <= 20))
        && (!('vipAlertEnabled' in data) || data.vipAlertEnabled is bool)
        && (!('vipAlertTitle' in data) || (data.vipAlertTitle is string && data.vipAlertTitle.size() <= 40))
        && (!('vipAlertStyle' in data) || data.vipAlertStyle in ['crystal_magenta', 'electric_pulse', 'aurora_vip'])
        && (!('vipAlertDurationSec' in data) || (data.vipAlertDurationSec is int && data.vipAlertDurationSec >= 3 && data.vipAlertDurationSec <= 10))
        && (!('vipAlertSound' in data) || data.vipAlertSound is bool)
        && data.startedAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isLiveStreamActive(streamId) {
      return exists(/databases/$(database)/documents/liveStreams/$(streamId))
        && get(/databases/$(database)/documents/liveStreams/$(streamId)).data.status == 'live';
    }

    function isValidLiveStreamMessage(data, messageId, streamId) {
      return data.keys().hasAll([
          'id', 'streamId', 'authorId', 'authorUsername', 'authorDisplayName',
          'authorAvatarUrl', 'text', 'kind', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'streamId', 'authorId', 'authorUsername', 'authorDisplayName',
          'authorAvatarUrl', 'text', 'kind', 'giftId', 'giftName', 'giftValue',
          'senderFanLevel', 'senderFanTitle', 'isTop1', 'triggeredAction', 'createdAt'
        ])
        && data.id == messageId
        && isValidId(data.id)
        && data.streamId == streamId
        && isValidId(data.streamId)
        && data.authorId == request.auth.uid
        && isValidUsername(data.authorUsername)
        && data.authorDisplayName is string && data.authorDisplayName.size() >= 1 && data.authorDisplayName.size() <= 40
        && data.authorAvatarUrl is string && data.authorAvatarUrl.size() <= 300
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 180
        && data.kind in ['chat', 'like', 'gift', 'join']
        && (!('giftId' in data) || (data.giftId is string && data.giftId.size() <= 32))
        && (!('giftName' in data) || (data.giftName is string && data.giftName.size() <= 40))
        && (!('giftValue' in data) || (data.giftValue is int && data.giftValue >= 0 && data.giftValue <= 100000))
        && (!('senderFanLevel' in data) || (data.senderFanLevel is int && data.senderFanLevel >= 1 && data.senderFanLevel <= 50))
        && (!('senderFanTitle' in data) || (data.senderFanTitle is string && data.senderFanTitle.size() >= 1 && data.senderFanTitle.size() <= 40))
        && (!('isTop1' in data) || data.isTop1 is bool)
        && (!('triggeredAction' in data) || (data.triggeredAction is string && data.triggeredAction.size() <= 80))
        && data.createdAt == request.time;
    }

    function isValidLiveGuest(data, guestUid, streamId) {
      return data.keys().hasAll([
          'uid', 'streamId', 'username', 'displayName', 'avatarUrl',
          'fanLevel', 'seatIndex', 'muted', 'joinedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'streamId', 'username', 'displayName', 'avatarUrl',
          'fanLevel', 'seatIndex', 'muted', 'isTop1', 'joinedAt'
        ])
        && data.uid == guestUid
        && isValidId(data.uid)
        && data.streamId == streamId
        && isValidId(data.streamId)
        && isValidUsername(data.username)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 40
        && data.avatarUrl is string && data.avatarUrl.size() <= 300
        && data.fanLevel is int && data.fanLevel >= 1 && data.fanLevel <= 50
        && data.seatIndex is int && data.seatIndex >= 0 && data.seatIndex <= 9
        && data.muted is bool
        && (!('isTop1' in data) || data.isTop1 is bool)
        && data.joinedAt is timestamp;
    }

    function isValidLiveJoinRequest(data, requesterUid, liveId) {
      return data.keys().hasAll([
          'id', 'liveId', 'userId', 'username', 'displayName', 'avatarUrl',
          'fanLevel', 'seatIndex', 'status', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'liveId', 'userId', 'username', 'displayName', 'avatarUrl',
          'fanLevel', 'seatIndex', 'status', 'createdAt'
        ])
        && data.id == requesterUid
        && isValidId(data.id)
        && data.liveId == liveId
        && isValidId(data.liveId)
        && data.userId == requesterUid
        && isValidUsername(data.username)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 40
        && data.avatarUrl is string && data.avatarUrl.size() <= 300
        && data.fanLevel is int && data.fanLevel >= 1 && data.fanLevel <= 50
        && data.seatIndex is int && data.seatIndex >= 0 && data.seatIndex <= 9
        && data.status in ['pending', 'accepted', 'rejected']
        && data.createdAt is timestamp;
    }

    function isValidCoinRecharge(data, rechargeId, userId) {
      return data.keys().hasAll([
          'id', 'userId', 'packageId', 'coinsCredited', 'bonusRoses', 'priceUsd', 'provider', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'packageId', 'coinsCredited', 'bonusRoses', 'priceUsd', 'provider', 'createdAt'
        ])
        && data.id == rechargeId
        && isValidId(data.id)
        && data.userId == userId
        && data.userId == request.auth.uid
        && data.packageId in ['pack_starter', 'pack_plus', 'pack_pro', 'pack_vip']
        && data.coinsCredited is int && data.coinsCredited >= 1 && data.coinsCredited <= 1635
        && data.bonusRoses is int && data.bonusRoses >= 0 && data.bonusRoses <= 3
        && data.priceUsd is number && data.priceUsd > 0 && data.priceUsd <= 100
        && data.provider == 'VexPay'
        && data.createdAt == request.time;
    }

    function isValidCreatorFanSupport(data, userId, creatorId) {
      return data.keys().hasAll([
          'userId', 'creatorId', 'totalCoinsDonated', 'fanLevel', 'fanTitle', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'creatorId', 'totalCoinsDonated', 'fanLevel', 'fanTitle', 'updatedAt'
        ])
        && data.userId == userId
        && data.userId == request.auth.uid
        && isValidId(data.userId)
        && data.creatorId == creatorId
        && isValidId(data.creatorId)
        && data.totalCoinsDonated is int && data.totalCoinsDonated >= 0 && data.totalCoinsDonated <= 100000000
        && data.fanLevel is int && data.fanLevel >= 1 && data.fanLevel <= 50
        && data.fanTitle is string && data.fanTitle.size() >= 1 && data.fanTitle.size() <= 40
        && data.updatedAt is timestamp;
    }

    function isValidLiveBattle(data, battleId) {
      return data.keys().hasAll([
          'id', 'status', 'durationSec', 'endsAtMs',
          'creator1Uid', 'creator1Username', 'creator1DisplayName', 'creator1AvatarUrl', 'creator1PreviewUrl', 'creator1Points', 'creator1WinStreak',
          'creator2Uid', 'creator2Username', 'creator2DisplayName', 'creator2AvatarUrl', 'creator2PreviewUrl', 'creator2Points', 'creator2WinStreak',
          'startedAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'hostStreamId', 'status', 'durationSec', 'endsAtMs',
          'creator1Uid', 'creator1Username', 'creator1DisplayName', 'creator1AvatarUrl', 'creator1PreviewUrl', 'creator1StreamUrl', 'creator1Points', 'creator1WinStreak',
          'creator2Uid', 'creator2Username', 'creator2DisplayName', 'creator2AvatarUrl', 'creator2PreviewUrl', 'creator2StreamUrl', 'creator2Points', 'creator2WinStreak',
          'lastGiftSender', 'lastGiftName', 'lastGiftTarget', 'lastGiftPoints',
          'startedAt', 'updatedAt'
        ])
        && data.id == battleId
        && isValidId(data.id)
        && (!('hostStreamId' in data) || (data.hostStreamId is string && data.hostStreamId.size() <= 128))
        && data.status in ['active', 'ended']
        && data.durationSec is int && data.durationSec >= 60 && data.durationSec <= 3600
        && data.endsAtMs is int && data.endsAtMs >= 0
        && isValidId(data.creator1Uid)
        && isValidUsername(data.creator1Username)
        && data.creator1DisplayName is string && data.creator1DisplayName.size() >= 1 && data.creator1DisplayName.size() <= 40
        && data.creator1AvatarUrl is string && data.creator1AvatarUrl.size() <= 300
        && data.creator1PreviewUrl is string && data.creator1PreviewUrl.size() <= 300
        && (!('creator1StreamUrl' in data) || (data.creator1StreamUrl is string && data.creator1StreamUrl.size() <= 300))
        && data.creator1Points is int && data.creator1Points >= 0 && data.creator1Points <= 100000000
        && data.creator1WinStreak is int && data.creator1WinStreak >= 0 && data.creator1WinStreak <= 1000
        && isValidId(data.creator2Uid)
        && isValidUsername(data.creator2Username)
        && data.creator2DisplayName is string && data.creator2DisplayName.size() >= 1 && data.creator2DisplayName.size() <= 40
        && data.creator2AvatarUrl is string && data.creator2AvatarUrl.size() <= 300
        && data.creator2PreviewUrl is string && data.creator2PreviewUrl.size() <= 300
        && (!('creator2StreamUrl' in data) || (data.creator2StreamUrl is string && data.creator2StreamUrl.size() <= 300))
        && data.creator2Points is int && data.creator2Points >= 0 && data.creator2Points <= 100000000
        && data.creator2WinStreak is int && data.creator2WinStreak >= 0 && data.creator2WinStreak <= 1000
        && (!('lastGiftSender' in data) || (data.lastGiftSender is string && data.lastGiftSender.size() <= 40))
        && (!('lastGiftName' in data) || (data.lastGiftName is string && data.lastGiftName.size() <= 40))
        && (!('lastGiftTarget' in data) || data.lastGiftTarget in ['creator1', 'creator2'])
        && (!('lastGiftPoints' in data) || (data.lastGiftPoints is int && data.lastGiftPoints >= 0 && data.lastGiftPoints <= 100000))
        && data.startedAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isLiveBattleActive(battleId) {
      return exists(/databases/$(database)/documents/liveBattles/$(battleId))
        && get(/databases/$(database)/documents/liveBattles/$(battleId)).data.status == 'active';
    }

    function isValidLiveBattleGift(data, giftId, battleId) {
      return data.keys().hasAll([
          'id', 'battleId', 'targetSlot', 'senderUid', 'senderUsername', 'senderDisplayName',
          'senderAvatarUrl', 'giftId', 'giftName', 'coins', 'points', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'battleId', 'targetSlot', 'senderUid', 'senderUsername', 'senderDisplayName',
          'senderAvatarUrl', 'giftId', 'giftName', 'coins', 'points', 'createdAt'
        ])
        && data.id == giftId
        && isValidId(data.id)
        && data.battleId == battleId
        && isValidId(data.battleId)
        && data.targetSlot in ['creator1', 'creator2']
        && data.senderUid == request.auth.uid
        && isValidUsername(data.senderUsername)
        && data.senderDisplayName is string && data.senderDisplayName.size() >= 1 && data.senderDisplayName.size() <= 40
        && data.senderAvatarUrl is string && data.senderAvatarUrl.size() <= 300
        && data.giftId is string && data.giftId.size() >= 1 && data.giftId.size() <= 32
        && data.giftName is string && data.giftName.size() >= 1 && data.giftName.size() <= 40
        && data.coins is int && data.coins >= 0 && data.coins <= 100000
        && data.points is int && data.points >= 1 && data.points <= 100000
        && data.createdAt == request.time;
    }

    // --- Collection Rules ---
    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && (isOwner(adminUid) || isAdmin());
      allow list, create, update, delete: if false;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || (resource != null && existing().isPublic == true) || isAdmin());
      allow list: if existing().isPublic == true || (isSignedIn() && existing().uid == request.auth.uid) || isBootstrappedOwner();
      allow create: if isVerified() && isValidId(userId) && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == request.auth.uid
        && (incoming().username != 'viroklipz' || isBootstrappedOwner())
        && (isBootstrappedOwner() || (!('isAdmin' in incoming()) && !('isVerified' in incoming())))
        && !('banned' in incoming())
        && !('isBanned' in incoming())
        && (!('coins' in incoming()) || incoming().coins == 0)
        && (!('freeRoses' in incoming()) || incoming().freeRoses == 0)
        && (!('welcomeRechargeClaimed' in incoming()) || incoming().welcomeRechargeClaimed == false)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && (incoming().username != 'viroklipz' || incoming().username == existing().username || isBootstrappedOwner())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            isOwner(userId)
            && incoming().uid == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'username', 'displayName', 'bio', 'bioColor', 'personalLink', 'pronouns', 'avatarUrl', 'isPublic', 'fcmToken', 'fcmTokenWeb', 'presenceStatus', 'mutedCommunityChat', 'fanLevel', 'fanPoints', 'coins', 'freeRoses', 'welcomeRechargeClaimed', 'country', 'updatedAt'
            ])
            && (
              !('coins' in incoming().diff(existing()).affectedKeys())
              || ('coins' in existing() && incoming().coins <= existing().coins + 1635)
              || (!('coins' in existing()) && incoming().coins <= 1635)
            )
            && (
              !('freeRoses' in incoming().diff(existing()).affectedKeys())
              || ('freeRoses' in existing() && incoming().freeRoses <= existing().freeRoses + 3)
              || (!('freeRoses' in existing()) && incoming().freeRoses <= 3)
            )
          )
          ||
          (
            isAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly(['isBanned', 'banned', 'isVerified', 'updatedAt'])
          )
          ||
          (
            isBootstrappedOwner()
            && isOwner(userId)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'isAdmin', 'isVerified', 'followersCount', 'realFollowersCount', 'seededFollowersCount', 'updatedAt'
            ])
            && incoming().isAdmin == true
            && incoming().isVerified == true
            && isValidFollowerBreakdown(incoming(), prevRealFollowers(existing()))
          )
          ||
          (
            userId != request.auth.uid
            && existing().isPublic == true
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'followersCount', 'realFollowersCount', 'seededFollowersCount', 'updatedAt'
            ])
            && (
              (
                !exists(/databases/$(database)/documents/users/$(request.auth.uid)/following/$(userId))
                && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/following/$(userId))
                && isValidFollowerBreakdown(incoming(), prevRealFollowers(existing()) + 1)
              )
              ||
              (
                exists(/databases/$(database)/documents/users/$(request.auth.uid)/following/$(userId))
                && !existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/following/$(userId))
                && prevRealFollowers(existing()) > 0
                && isValidFollowerBreakdown(incoming(), prevRealFollowers(existing()) - 1)
              )
            )
          )
        );
      allow delete: if isVerified() && isValidId(userId) && (isOwner(userId) || isAdmin());

      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isVerified() && isValidId(userId) && isValidId(docId) && isOwner(userId) && (
          (docId == 'info' && isValidPrivateInfo(incoming(), userId) && incoming().updatedAt == request.time)
          ||
          (docId == 'streak' && isValidUserStreak(incoming(), userId) && incoming().updatedAt == request.time)
        );
        allow update: if isVerified() && isValidId(userId) && isValidId(docId) && isOwner(userId) && (
          (
            docId == 'info'
            && isValidPrivateInfo(incoming(), userId)
            && incoming().uid == existing().uid
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly(['firstName', 'lastName', 'phone', 'email', 'updatedAt'])
          )
          ||
          (
            docId == 'streak'
            && isValidUserStreak(incoming(), userId)
            && incoming().uid == existing().uid
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly(['currentStreak', 'longestStreak', 'lastActiveDate', 'updatedAt'])
          )
        );
        allow delete: if false;
      }

      match /likes/{clipId} {
        allow get: if isValidId(userId) && isValidId(clipId) && isOwner(userId);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;
        allow create: if isVerified() && isValidId(userId) && isValidId(clipId) && isOwner(userId)
          && isValidUserReaction(incoming(), userId, clipId);
        allow update: if false;
        allow delete: if isVerified() && isValidId(userId) && isValidId(clipId) && isOwner(userId);
      }

      match /bookmarks/{clipId} {
        allow get: if isValidId(userId) && isValidId(clipId) && isOwner(userId);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;
        allow create: if isVerified() && isValidId(userId) && isValidId(clipId) && isOwner(userId)
          && isValidUserReaction(incoming(), userId, clipId);
        allow update: if false;
        allow delete: if isVerified() && isValidId(userId) && isValidId(clipId) && isOwner(userId);
      }

      match /following/{targetId} {
        allow get: if isValidId(userId) && isValidId(targetId) && isOwner(userId);
        allow list: if isOwner(userId) && existing().followerId == request.auth.uid;
        allow create: if isVerified() && isValidId(userId) && isValidId(targetId) && isOwner(userId)
          && isValidUserFollow(incoming(), userId, targetId);
        allow update: if false;
        allow delete: if isVerified() && isValidId(userId) && isValidId(targetId) && isOwner(userId);
      }

      match /blocked/{targetId} {
        allow get: if isValidId(userId) && isValidId(targetId) && isOwner(userId);
        allow list: if isOwner(userId) && existing().blockerId == request.auth.uid;
        allow create: if isVerified() && isValidId(userId) && isValidId(targetId) && isOwner(userId)
          && isValidUserBlock(incoming(), userId, targetId);
        allow update: if false;
        allow delete: if isVerified() && isValidId(userId) && isValidId(targetId) && isOwner(userId);
      }

      match /recharges/{rechargeId} {
        allow get: if isValidId(userId) && isValidId(rechargeId) && (isOwner(userId) || isAdmin());
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;
        allow create: if isVerified() && isValidId(userId) && isValidId(rechargeId) && isOwner(userId)
          && isValidCoinRecharge(incoming(), rechargeId, userId);
        allow update, delete: if false;
      }

      match /creatorSupport/{creatorId} {
        allow get: if isValidId(userId) && isValidId(creatorId) && (isOwner(userId) || isOwner(creatorId) || isAdmin());
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;
        allow create: if isVerified() && isValidId(userId) && isValidId(creatorId) && isOwner(userId)
          && isValidCreatorFanSupport(incoming(), userId, creatorId)
          && incoming().updatedAt == request.time;
        allow update: if isVerified() && isValidId(userId) && isValidId(creatorId) && isOwner(userId)
          && isValidCreatorFanSupport(incoming(), userId, creatorId)
          && incoming().userId == existing().userId
          && incoming().creatorId == existing().creatorId
          && incoming().totalCoinsDonated >= existing().totalCoinsDonated
          && incoming().totalCoinsDonated <= existing().totalCoinsDonated + 100000
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['totalCoinsDonated', 'fanLevel', 'fanTitle', 'updatedAt']);
        allow delete: if false;
      }
    }

    match /clips/{clipId} {
      allow get: if isValidId(clipId) && (
        (resource != null && existing().visibility == 'public')
        || (isSignedIn() && resource != null && existing().authorId == request.auth.uid)
        || isAdmin()
      );
      allow list: if existing().visibility == 'public'
        || (isSignedIn() && existing().authorId == request.auth.uid)
        || isBootstrappedOwner();

      allow create: if isVerified() && isValidId(clipId)
        && isValidClip(incoming(), clipId)
        && incoming().authorId == request.auth.uid
        && 'mediaType' in incoming()
        && incoming().mediaType == 'video'
        && incoming().likesCount == 0
        && incoming().bookmarksCount == 0
        && incoming().viewsCount == 0
        && incoming().sharesCount == 0
        && (!('replaysCount' in incoming()) || incoming().replaysCount == 0)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerified() && isValidId(clipId) && isValidClip(incoming(), clipId) && (
        // Tier 1: Clip Author edits caption, category, hashtags, visibility, or synced author metadata
        (
          existing().authorId == request.auth.uid
          && incoming().authorId == existing().authorId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'caption',
            'category',
            'hashtags',
            'visibility',
            'authorDisplayName',
            'authorUsername',
            'authorAvatarUrl',
            'updatedAt'
          ])
        )
        ||
        // Tier 2a: Atomic Like (+1 synced with /users/{uid}/likes/{clipId})
        (
          existing().visibility == 'public'
          && incoming().authorId == existing().authorId
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['likesCount'])
          && incoming().likesCount == existing().likesCount + 1
          && !exists(/databases/$(database)/documents/users/$(request.auth.uid)/likes/$(clipId))
          && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/likes/$(clipId))
        )
        ||
        // Tier 2b: Atomic Unlike (-1 synced with /users/{uid}/likes/{clipId})
        (
          existing().visibility == 'public'
          && incoming().authorId == existing().authorId
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['likesCount'])
          && existing().likesCount > 0
          && incoming().likesCount == existing().likesCount - 1
          && exists(/databases/$(database)/documents/users/$(request.auth.uid)/likes/$(clipId))
          && !existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/likes/$(clipId))
        )
        ||
        // Tier 2c: Atomic Bookmark (+1 synced with /users/{uid}/bookmarks/{clipId})
        (
          existing().visibility == 'public'
          && incoming().authorId == existing().authorId
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['bookmarksCount'])
          && (
            ('bookmarksCount' in existing() && incoming().bookmarksCount == existing().bookmarksCount + 1)
            || (!('bookmarksCount' in existing()) && incoming().bookmarksCount == 1)
          )
          && !exists(/databases/$(database)/documents/users/$(request.auth.uid)/bookmarks/$(clipId))
          && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/bookmarks/$(clipId))
        )
        ||
        // Tier 2d: Atomic Unbookmark (-1 synced with /users/{uid}/bookmarks/{clipId})
        (
          existing().visibility == 'public'
          && incoming().authorId == existing().authorId
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['bookmarksCount'])
          && 'bookmarksCount' in existing() && existing().bookmarksCount > 0
          && incoming().bookmarksCount == existing().bookmarksCount - 1
          && exists(/databases/$(database)/documents/users/$(request.auth.uid)/bookmarks/$(clipId))
          && !existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/bookmarks/$(clipId))
        )
        ||
        // Tier 2e: View increment (+1)
        (
          existing().visibility == 'public'
          && incoming().authorId == existing().authorId
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['viewsCount'])
          && (
            ('viewsCount' in existing() && incoming().viewsCount == existing().viewsCount + 1)
            || (!('viewsCount' in existing()) && incoming().viewsCount == 1)
          )
        )
        ||
        // Tier 2f: Share increment (+1)
        (
          existing().visibility == 'public'
          && incoming().authorId == existing().authorId
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['sharesCount'])
          && incoming().sharesCount == existing().sharesCount + 1
        )
        ||
        // Tier 2g: Replay/Repeat increment (+1)
        (
          existing().visibility == 'public'
          && incoming().authorId == existing().authorId
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['replaysCount'])
          && (
            ('replaysCount' in existing() && incoming().replaysCount == existing().replaysCount + 1)
            || (!('replaysCount' in existing()) && incoming().replaysCount == 1)
          )
        )
      );

      allow delete: if isVerified() && isValidId(clipId) && (existing().authorId == request.auth.uid || isAdmin());

      match /comments/{commentId} {
        allow get: if isValidId(clipId) && isValidId(commentId)
          && (get(/databases/$(database)/documents/clips/$(clipId)).data.visibility == 'public' || isAdmin());
        allow list: if existing().clipId == clipId;
        allow create: if isVerified() && isValidId(clipId) && isValidId(commentId)
          && isValidComment(incoming(), commentId, clipId)
          && exists(/databases/$(database)/documents/clips/$(clipId))
          && get(/databases/$(database)/documents/clips/$(clipId)).data.visibility == 'public';
        allow update: if false;
        allow delete: if isVerified() && isValidId(clipId) && isValidId(commentId)
          && (
            existing().authorId == request.auth.uid
            || get(/databases/$(database)/documents/clips/$(clipId)).data.authorId == request.auth.uid
            || isAdmin()
          );
      }
    }

    match /starterComments/{commentId} {
      allow get: if isValidId(commentId) && resource != null && isStarterClipId(existing().clipId);
      allow list: if isStarterClipId(existing().clipId);
      allow create: if isVerified() && isValidId(commentId)
        && isStarterClipId(incoming().clipId)
        && isValidComment(incoming(), commentId, incoming().clipId);
      allow update: if false;
      allow delete: if isVerified() && isValidId(commentId) && (existing().authorId == request.auth.uid || isAdmin());
    }

    match /chats/{roomId}/messages/{messageId} {
      allow get: if isSignedIn() && isValidChatRoom(roomId) && isValidId(messageId);
      allow list: if isSignedIn() && isValidChatRoom(roomId) && existing().roomId == roomId;
      allow create: if isVerified() && isValidChatRoom(roomId) && isValidId(messageId)
        && isValidChatMessage(incoming(), messageId, roomId);
      allow update: if false;
      allow delete: if isVerified() && isValidChatRoom(roomId) && isValidId(messageId)
        && (existing().authorId == request.auth.uid || isAdmin());
    }

    match /reports/{reportId} {
      allow get: if isAdmin() && isValidId(reportId);
      allow list: if isBootstrappedOwner() && isValidId(existing().id);
      allow create: if isVerified() && isValidId(reportId)
        && isValidReport(incoming(), reportId)
        && incoming().reporterId == request.auth.uid
        && (!('status' in incoming()) || incoming().status == 'pending')
        && !('reviewedBy' in incoming())
        && !('reviewedAt' in incoming())
        && incoming().createdAt == request.time;
      allow update: if isAdmin() && isValidId(reportId)
        && isValidReport(incoming(), reportId)
        && incoming().id == existing().id
        && incoming().reporterId == existing().reporterId
        && incoming().targetType == existing().targetType
        && incoming().targetId == existing().targetId
        && incoming().targetAuthorId == existing().targetAuthorId
        && incoming().createdAt == existing().createdAt
        && incoming().reviewedBy == request.auth.uid
        && incoming().reviewedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt']);
      allow delete: if isAdmin() && isValidId(reportId);
    }

    match /directThreads/{threadId} {
      allow get: if isSignedIn() && isValidId(threadId)
        && resource != null && request.auth.uid in existing().participantIds;
      allow list: if isSignedIn() && request.auth.uid in existing().participantIds;
      allow create: if isVerified() && isValidId(threadId)
        && isValidDirectThread(incoming(), threadId)
        && (!('lastMessageDate' in incoming()) || incoming().lastMessageDate == request.time)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(threadId)
        && request.auth.uid in existing().participantIds
        && isValidDirectThread(incoming(), threadId)
        && incoming().id == existing().id
        && incoming().participantIds == existing().participantIds
        && incoming().createdAt == existing().createdAt
        && (!('lastMessageDate' in incoming()) || !('lastMessageDate' in incoming().diff(existing()).affectedKeys()) || incoming().lastMessageDate == request.time)
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['lastMessageText', 'lastSenderId', 'streak', 'lastMessageDate', 'updatedAt']);
      allow delete: if false;

      match /messages/{messageId} {
        allow get: if isValidId(threadId) && isValidId(messageId)
          && isDirectThreadParticipant(threadId);
        allow list: if isDirectThreadParticipant(threadId) && existing().threadId == threadId;
        allow create: if isVerified() && isValidId(threadId) && isValidId(messageId)
          && isDirectThreadParticipant(threadId)
          && isValidDirectMessage(incoming(), messageId, threadId);
        allow update: if false;
        allow delete: if isVerified() && isValidId(threadId) && isValidId(messageId)
          && isDirectThreadParticipant(threadId)
          && existing().authorId == request.auth.uid;
      }
    }

    match /statusNotes/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn() && existing().presence in ['online', 'busy', 'hidden'];
      allow create: if isVerified() && isValidId(userId) && isOwner(userId)
        && isValidStatusNote(incoming(), userId)
        && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(userId) && isOwner(userId)
        && isValidStatusNote(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time;
      allow delete: if isVerified() && isValidId(userId) && (isOwner(userId) || isAdmin());
    }

    match /community_chat/{messageId} {
      allow get: if isSignedIn() && isValidId(messageId);
      allow list: if isSignedIn() && existing().roomId == 'community';
      allow create: if isVerified() && isValidId(messageId)
        && isValidCommunityChatMessage(incoming(), messageId);
      allow update: if false;
      allow delete: if isVerified() && isValidId(messageId)
        && (existing().authorId == request.auth.uid || isAdmin());
    }

    match /liveStreams/{streamId} {
      allow get: if isValidId(streamId) && resource != null && (
        existing().status == 'live'
        || (isSignedIn() && existing().hostUid == request.auth.uid)
        || isAdmin()
      );
      allow list: if existing().status == 'live'
        || (isSignedIn() && existing().hostUid == request.auth.uid)
        || isBootstrappedOwner();
      allow create: if isVerified() && isValidId(streamId)
        && isValidLiveStream(incoming(), streamId)
        && incoming().hostUid == request.auth.uid
        && incoming().status == 'live'
        && incoming().viewerCount == 1
        && incoming().likesCount == 0
        && (!('giftsCount' in incoming()) || incoming().giftsCount == 0)
        && incoming().startedAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(streamId)
        && isValidLiveStream(incoming(), streamId)
        && incoming().id == existing().id
        && incoming().hostUid == existing().hostUid
        && incoming().startedAt == existing().startedAt
        && incoming().updatedAt == request.time
        && (
          (
            isAdmin()
            && incoming().status == 'ended'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
          ||
          (
            existing().status == 'live' && (
              (
                existing().hostUid == request.auth.uid
                && incoming().diff(existing()).affectedKeys().hasOnly([
                  'title', 'about', 'audience', 'quality', 'visualEffect',
                  'backgroundPreset', 'commentPermission', 'giftsEnabled', 'noiseCancellation',
                  'category', 'previewImageUrl', 'streamUrl', 'guestUid', 'guestDisplayName', 'guestStreamUrl',
                  'guests',
                  'fanPerks', 'audienceFavorites', 'fanClubName', 'fanPointsPerCoin',
                  'vipAlertEnabled', 'vipAlertTitle', 'vipAlertStyle', 'vipAlertDurationSec', 'vipAlertSound',
                  'status', 'viewerCount', 'updatedAt'
                ])
              )
              ||
              (
                incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'updatedAt'])
                && incoming().likesCount == existing().likesCount + 1
              )
              ||
              (
                incoming().diff(existing()).affectedKeys().hasOnly(['giftsCount', 'updatedAt'])
                && (
                  ('giftsCount' in existing() && incoming().giftsCount == existing().giftsCount + 1)
                  || (!('giftsCount' in existing()) && incoming().giftsCount == 1)
                )
              )
              ||
              (
                incoming().diff(existing()).affectedKeys().hasOnly(['viewerCount', 'updatedAt'])
                && (
                  incoming().viewerCount == existing().viewerCount + 1
                  || (existing().viewerCount > 1 && incoming().viewerCount == existing().viewerCount - 1)
                )
              )
            )
          )
        );
      allow delete: if isVerified() && isValidId(streamId) && (existing().hostUid == request.auth.uid || isAdmin());

      match /messages/{messageId} {
        allow get: if isValidId(streamId) && isValidId(messageId)
          && (isLiveStreamActive(streamId) || isAdmin());
        allow list: if existing().streamId == streamId && isLiveStreamActive(streamId);
        allow create: if isVerified() && isValidId(streamId) && isValidId(messageId)
          && isLiveStreamActive(streamId)
          && isValidLiveStreamMessage(incoming(), messageId, streamId);
        allow update: if false;
        allow delete: if isVerified() && isValidId(streamId) && isValidId(messageId)
          && (
            existing().authorId == request.auth.uid
            || get(/databases/$(database)/documents/liveStreams/$(streamId)).data.hostUid == request.auth.uid
            || isAdmin()
          );
      }

      match /guests/{guestUid} {
        allow get: if isValidId(streamId) && isValidId(guestUid)
          && (isLiveStreamActive(streamId) || isOwner(guestUid) || isAdmin());
        allow list: if existing().streamId == streamId;
        allow create: if isVerified() && isValidId(streamId) && isValidId(guestUid)
          && isLiveStreamActive(streamId)
          && get(/databases/$(database)/documents/liveStreams/$(streamId)).data.hostUid == request.auth.uid
          && isValidLiveGuest(incoming(), guestUid, streamId)
          && incoming().joinedAt == request.time;
        allow update: if isVerified() && isValidId(streamId) && isValidId(guestUid)
          && isLiveStreamActive(streamId)
          && isValidLiveGuest(incoming(), guestUid, streamId)
          && incoming().uid == existing().uid
          && incoming().streamId == existing().streamId
          && incoming().joinedAt == existing().joinedAt
          && (
            (
              get(/databases/$(database)/documents/liveStreams/$(streamId)).data.hostUid == request.auth.uid
              && incoming().diff(existing()).affectedKeys().hasOnly(['muted', 'seatIndex', 'isTop1'])
            )
            ||
            (
              isOwner(guestUid)
              && incoming().diff(existing()).affectedKeys().hasOnly(['muted'])
            )
          );
        allow delete: if isVerified() && isValidId(streamId) && isValidId(guestUid)
          && (
            isOwner(guestUid)
            || get(/databases/$(database)/documents/liveStreams/$(streamId)).data.hostUid == request.auth.uid
            || isAdmin()
          );
      }

      match /joinRequests/{requesterUid} {
        allow get: if isSignedIn() && isValidId(streamId) && isValidId(requesterUid)
          && (
            isOwner(requesterUid)
            || get(/databases/$(database)/documents/liveStreams/$(streamId)).data.hostUid == request.auth.uid
            || isAdmin()
          );
        allow list: if isSignedIn() && existing().liveId == streamId;
        allow create: if isVerified() && isValidId(streamId) && isValidId(requesterUid)
          && isOwner(requesterUid)
          && isLiveStreamActive(streamId)
          && isValidLiveJoinRequest(incoming(), requesterUid, streamId)
          && incoming().userId == request.auth.uid
          && incoming().status == 'pending'
          && incoming().createdAt == request.time;
        allow update: if isVerified() && isValidId(streamId) && isValidId(requesterUid)
          && isLiveStreamActive(streamId)
          && isValidLiveJoinRequest(incoming(), requesterUid, streamId)
          && incoming().id == existing().id
          && incoming().liveId == existing().liveId
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && get(/databases/$(database)/documents/liveStreams/$(streamId)).data.hostUid == request.auth.uid
          && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'seatIndex']);
        allow delete: if isVerified() && isValidId(streamId) && isValidId(requesterUid)
          && (
            isOwner(requesterUid)
            || get(/databases/$(database)/documents/liveStreams/$(streamId)).data.hostUid == request.auth.uid
            || isAdmin()
          );
      }
    }

    match /liveConfigs/{creatorUid} {
      allow get: if isSignedIn() && isValidId(creatorUid);
      allow list: if false;
      allow create: if isVerified() && isValidId(creatorUid) && isOwner(creatorUid)
        && isValidLiveConfig(incoming(), creatorUid)
        && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(creatorUid) && isOwner(creatorUid)
        && isValidLiveConfig(incoming(), creatorUid)
        && incoming().creatorUid == existing().creatorUid
        && incoming().updatedAt == request.time;
      allow delete: if isVerified() && isValidId(creatorUid) && (isOwner(creatorUid) || isAdmin());
    }

    match /liveBattles/{battleId} {
      allow get: if isValidId(battleId) && resource != null && (
        existing().status == 'active'
        || (isSignedIn() && (existing().creator1Uid == request.auth.uid || existing().creator2Uid == request.auth.uid))
        || isAdmin()
      );
      allow list: if existing().status == 'active'
        || (isSignedIn() && (existing().creator1Uid == request.auth.uid || existing().creator2Uid == request.auth.uid))
        || isBootstrappedOwner();
      allow create: if isVerified() && isValidId(battleId)
        && isValidLiveBattle(incoming(), battleId)
        && (incoming().creator1Uid == request.auth.uid || isAdmin())
        && incoming().status == 'active'
        && incoming().creator1Points == 0
        && incoming().creator2Points == 0
        && incoming().startedAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(battleId)
        && isValidLiveBattle(incoming(), battleId)
        && incoming().id == existing().id
        && incoming().creator1Uid == existing().creator1Uid
        && incoming().creator2Uid == existing().creator2Uid
        && incoming().startedAt == existing().startedAt
        && incoming().updatedAt == request.time
        && (
          (
            (existing().creator1Uid == request.auth.uid || isAdmin())
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'endsAtMs', 'creator1Points', 'creator2Points', 'creator1WinStreak', 'creator2WinStreak', 'updatedAt'
            ])
          )
          ||
          (
            existing().status == 'active'
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'creator1Points', 'lastGiftSender', 'lastGiftName', 'lastGiftTarget', 'lastGiftPoints', 'updatedAt'
            ])
            && incoming().creator1Points > existing().creator1Points
            && incoming().creator1Points <= existing().creator1Points + 100000
          )
          ||
          (
            existing().status == 'active'
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'creator2Points', 'lastGiftSender', 'lastGiftName', 'lastGiftTarget', 'lastGiftPoints', 'updatedAt'
            ])
            && incoming().creator2Points > existing().creator2Points
            && incoming().creator2Points <= existing().creator2Points + 100000
          )
        );
      allow delete: if isVerified() && isValidId(battleId) && (existing().creator1Uid == request.auth.uid || isAdmin());

      match /gifts/{giftId} {
        allow get: if isValidId(battleId) && isValidId(giftId) && (isLiveBattleActive(battleId) || isAdmin());
        allow list: if existing().battleId == battleId && isLiveBattleActive(battleId);
        allow create: if isVerified() && isValidId(battleId) && isValidId(giftId)
          && isLiveBattleActive(battleId)
          && isValidLiveBattleGift(incoming(), giftId, battleId);
        allow update: if false;
        allow delete: if isVerified() && isValidId(battleId) && isValidId(giftId)
          && (existing().senderUid == request.auth.uid || isAdmin());
      }
    }
  }
}
