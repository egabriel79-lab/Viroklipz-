      "schema": { "$ref": "#/entities/UserFollow" },
      "description": "Creators followed by this user."
    },
    "/users/{userId}/blocked/{targetId}": {
      "schema": { "$ref": "#/entities/UserBlock" },
      "description": "Accounts blocked by this user."
    },
    "/clips/{clipId}": {
      "schema": { "$ref": "#/entities/Clip" },
      "description": "Published short-form vertical clips."
    },
    "/clips/{clipId}/comments/{commentId}": {
      "schema": { "$ref": "#/entities/ClipComment" },
      "description": "Real-time comments attached to a Firestore clip."
    },
    "/starterComments/{commentId}": {
      "schema": { "$ref": "#/entities/ClipComment" },
      "description": "Real-time comments on curated Viroklipz showcase clips."
    },
    "/chats/{roomId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Real-time community chat rooms."
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "#/entities/ContentReport" },
      "description": "Moderation reports submitted by verified users and reviewed by owner/admin."
    },
    "/directThreads/{threadId}": {
      "schema": { "$ref": "#/entities/DirectThread" },
      "description": "1-to-1 direct message threads accessible strictly to both participants."
    },
    "/directThreads/{threadId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/DirectMessage" },
      "description": "Messages inside a direct thread, gated by parent participant membership."
    },
    "/statusNotes/{userId}": {
      "schema": { "$ref": "#/entities/StatusNote" },
      "description": "Short user status notes and availability states displayed in Mensajes."
    },
    "/community_chat/{messageId}": {
      "schema": { "$ref": "#/entities/CommunityChatMessage" },
      "description": "Global real-time community chat room messages."
    },
    "/liveStreams/{streamId}": {
      "schema": { "$ref": "#/entities/LiveStream" },
      "description": "Active and ended creator live broadcasts shown in Para ti and En vivo."
    },
    "/liveStreams/{streamId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/LiveStreamMessage" },
      "description": "Real-time chat, heart, join, and gift events inside an active live stream room."
    },
    "/liveStreams/{streamId}/guests/{guestUid}": {
      "schema": { "$ref": "#/entities/LiveGuest" },
      "description": "Accepted multi-guest party participants and mic mute state inside an active Live."
    },
    "/liveStreams/{streamId}/joinRequests/{requesterUid}": {
      "schema": { "$ref": "#/entities/LiveJoinRequest" },
      "description": "Pending viewer requests to join the ViroParty multi-guest grid."
    },
    "/liveConfigs/{creatorUid}": {
      "schema": { "$ref": "#/entities/CreatorLiveConfig" },
      "description": "Saved Fan Club perks and Audience Favorites per creator."
    },
    "/users/{userId}/recharges/{rechargeId}": {
      "schema": { "$ref": "#/entities/CoinRecharge" },
      "description": "Verified VexPay coin recharge receipts per user."
    },
    "/liveBattles/{battleId}": {
      "schema": { "$ref": "#/entities/LiveBattle" },
      "description": "Real-time ViroArena PK battles between two creators."
    },
    "/liveBattles/{battleId}/gifts/{giftId}": {
      "schema": { "$ref": "#/entities/LiveBattleGift" },
      "description": "Gift events sent during a ViroArena PK battle."
    }
  }
