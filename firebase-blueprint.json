{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public creator profile for Viroklipz without PII.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "username": {
          "type": "string",
          "minLength": 3,
          "maxLength": 24,
          "pattern": "^[a-z0-9._]{3,24}$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "bio": {
          "type": "string",
          "maxLength": 160
        },
        "bioColor": {
          "type": "string",
          "maxLength": 16
        },
        "personalLink": {
          "type": "string",
          "maxLength": 160
        },
        "pronouns": {
          "type": "string",
          "maxLength": 32
        },
        "avatarUrl": {
          "type": "string",
          "maxLength": 300
        },
        "isPublic": {
          "type": "boolean"
        },
        "fcmTokenWeb": {
          "type": "string",
          "maxLength": 512
        },
        "presenceStatus": {
          "type": "string",
          "enum": ["online", "busy", "hidden"]
        },
        "mutedCommunityChat": {
          "type": "boolean"
        },
        "fanLevel": {
          "type": "number",
          "description": "Viewer Fan Club level (1 to 50) earned through engagement and gifts."
        },
        "fanPoints": {
          "type": "number",
          "description": "Cumulative Fan Club XP points."
        },
        "banned": {
          "type": "boolean",
          "description": "Account suspension flag updated exclusively by admins."
        },
        "isBanned": {
          "type": "boolean",
          "description": "Account suspension flag updated exclusively by admins from the Flutter Admin Dashboard."
        },
        "isAdmin": {
          "type": "boolean",
          "description": "Administrator privilege flag provisioned server-side or via console; never user-writable."
        },
        "coins": {
          "type": "number",
          "description": "Viroklipz virtual coin balance."
        },
        "freeRoses": {
          "type": "number",
          "description": "Bonus free Roses granted from the Welcome Offer."
        },
        "welcomeRechargeClaimed": {
          "type": "boolean",
          "description": "Whether the user has already claimed the first recharge welcome offer."
        },
        "followersCount": {
          "type": "number",
          "description": "Cached follower count."
        },
        "country": {
          "type": "string",
          "maxLength": 64,
          "description": "Optional country label for admin analytics."
        },
        "email": {
          "type": "string",
          "maxLength": 120,
          "description": "Optional account email if synced for admin moderation."
        },
        "age": {
          "type": "number",
          "description": "Declared user age at registration."
        },
        "isMinor": {
          "type": "boolean",
          "description": "True when the user registered under 18 years old."
        },
        "guardianData": {
          "type": "object",
          "description": "Legal guardian authorization map { name, surname, id, authorized } required when isMinor is true."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "username", "displayName", "bio", "avatarUrl", "isPublic", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
