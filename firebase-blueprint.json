{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public creator profile for Viroklipz without PII.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "username": {
          "type": "string",
          "minLength": 3,
          "maxLength": 24,
          "pattern": "^[a-z0-9._]{3,24}$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "bio": {
          "type": "string",
          "maxLength": 160
        },
        "avatarUrl": {
          "type": "string",
          "maxLength": 300
        },
        "isPublic": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "username", "displayName", "bio", "avatarUrl", "isPublic", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated private PII record for authenticated user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "firstName": {
          "type": "string",
          "maxLength": 40
        },
        "lastName": {
          "type": "string",
          "maxLength": 40
        },
        "phone": {
          "type": "string",
          "maxLength": 24
        },
        "email": {
          "type": "string",
          "maxLength": 120
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "firstName", "lastName", "phone", "email", "updatedAt"]
    },
    "UserStreak": {
      "title": "UserStreak",
      "description": "Daily activity streak (racha) for authenticated Viroklipz user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "currentStreak": {
          "type": "number"
        },
        "longestStreak": {
          "type": "number"
        },
        "lastActiveDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "currentStreak", "longestStreak", "lastActiveDate", "updatedAt"]
    },
    "UserReaction": {
      "title": "UserReaction",
      "description": "User like or bookmark reference for a clip.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "clipId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "clipId", "createdAt"]
    },
    "UserFollow": {
      "title": "UserFollow",
      "description": "Following relationship owned by the follower.",
      "type": "object",
      "properties": {
        "followerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "targetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "targetUsername": {
          "type": "string",
          "minLength": 3,
          "maxLength": 24
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["followerId", "targetId", "targetUsername", "createdAt"]
    },
    "Clip": {
      "title": "Clip",
      "description": "Short-form vertical clip metadata in Viroklipz.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorUsername": {
          "type": "string",
          "minLength": 3,
          "maxLength": 24,
          "pattern": "^[a-z0-9._]{3,24}$"
        },
        "authorDisplayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "authorAvatarUrl": {
          "type": "string",
          "maxLength": 300
        },
        "caption": {
          "type": "string",
          "minLength": 1,
          "maxLength": 220
        },
        "category": {
          "type": "string",
          "enum": ["baile", "musica", "cocina", "deportes", "arte", "comedia", "viajes"]
        },
        "hashtags": {
          "type": "array"
        },
        "audioTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "audioPreset": {
          "type": "string",
          "enum": ["urban_beat", "sunset_house", "lofi_espresso", "alpine_rush", "analog_synth"]
        },
        "visualPreset": {
          "type": "string",
          "maxLength": 120
        },
        "videoUrl": {
          "type": "string",
          "maxLength": 300
        },
        "durationSec": {
          "type": "number"
        },
        "hasLocalMedia": {
          "type": "boolean"
        },
        "visibility": {
          "type": "string",
          "enum": ["public", "private"]
        },
        "likesCount": {
          "type": "number"
        },
        "bookmarksCount": {
          "type": "number"
        },
        "viewsCount": {
          "type": "number"
        },
        "sharesCount": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "authorId",
        "authorUsername",
        "authorDisplayName",
        "authorAvatarUrl",
        "caption",
        "category",
        "hashtags",
        "audioTitle",
        "audioPreset",
        "visualPreset",
        "durationSec",
        "hasLocalMedia",
        "visibility",
        "likesCount",
        "bookmarksCount",
        "viewsCount",
        "sharesCount",
        "createdAt",
        "updatedAt"
      ]
    },
    "ClipComment": {
      "title": "ClipComment",
      "description": "User comment on a Viroklipz clip.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "clipId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorUsername": {
          "type": "string",
          "minLength": 3,
          "maxLength": 24,
          "pattern": "^[a-z0-9._]{3,24}$"
        },
        "authorAvatarUrl": {
          "type": "string",
          "maxLength": 300
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "clipId", "authorId", "authorUsername", "authorAvatarUrl", "text", "createdAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Real-time community room chat message in Viroklipz.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "roomId": {
          "type": "string",
          "enum": ["general", "musica", "baile", "cocina"]
        },
        "authorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorUsername": {
          "type": "string",
          "minLength": 3,
          "maxLength": 24,
          "pattern": "^[a-z0-9._]{3,24}$"
        },
        "authorAvatarUrl": {
          "type": "string",
          "maxLength": 300
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "roomId", "authorId", "authorUsername", "authorAvatarUrl", "text", "createdAt"]
    },
    "UserBlock": {
      "title": "UserBlock",
      "description": "Blocked creator entry owned by the blocker user.",
      "type": "object",
      "properties": {
        "blockerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "targetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "targetUsername": {
          "type": "string",
          "minLength": 3,
          "maxLength": 24
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["blockerId", "targetId", "targetUsername", "createdAt"]
    },
    "ContentReport": {
      "title": "ContentReport",
      "description": "Write-only moderation report submitted by an authenticated user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "reporterId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "targetType": {
          "type": "string",
          "enum": ["clip", "chat_message", "user"]
        },
        "targetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "targetAuthorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "reason": {
          "type": "string",
          "enum": ["spam", "acoso", "contenido_inapropiado", "derechos_autor"]
        },
        "details": {
          "type": "string",
          "maxLength": 240
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "reporterId", "targetType", "targetId", "targetAuthorId", "reason", "details", "createdAt"]
    },
    "DirectThread": {
      "title": "DirectThread",
      "description": "1-to-1 direct conversation metadata between two Viroklipz accounts.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "participantIds": {
          "type": "array"
        },
        "lastMessageText": {
          "type": "string",
          "maxLength": 240
        },
        "lastSenderId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "participantIds", "lastMessageText", "lastSenderId", "createdAt", "updatedAt"]
    },
    "DirectMessage": {
      "title": "DirectMessage",
      "description": "Individual direct message inside a 1-to-1 DirectThread.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "threadId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorUsername": {
          "type": "string",
          "minLength": 3,
          "maxLength": 24,
          "pattern": "^[a-z0-9._]{3,24}$"
        },
        "authorAvatarUrl": {
          "type": "string",
          "maxLength": 300
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "threadId", "authorId", "authorUsername", "authorAvatarUrl", "text", "createdAt"]
    },
    "StatusNote": {
      "title": "StatusNote",
      "description": "Short ephemeral note and presence indicator shown in Mensajes.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "username": {
          "type": "string",
          "minLength": 3,
          "maxLength": 24,
          "pattern": "^[a-z0-9._]{3,24}$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "avatarUrl": {
          "type": "string",
          "maxLength": 300
        },
        "note": {
          "type": "string",
          "maxLength": 60
        },
        "presence": {
          "type": "string",
          "enum": ["online", "busy", "hidden"]
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "username", "displayName", "avatarUrl", "note", "presence", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Public creator profiles without PII."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Private PII and user streak documents strictly accessible to owner."
    },
    "/users/{userId}/likes/{clipId}": {
      "schema": { "$ref": "#/entities/UserReaction" },
      "description": "Clips liked by this user."
    },
    "/users/{userId}/bookmarks/{clipId}": {
      "schema": { "$ref": "#/entities/UserReaction" },
      "description": "Clips saved/bookmarked by this user."
    },
    "/users/{userId}/following/{targetId}": {
      "schema": { "$ref": "#/entities/UserFollow" },
      "description": "Creators followed by this user."
    },
    "/users/{userId}/blocked/{targetId}": {
      "schema": { "$ref": "#/entities/UserBlock" },
      "description": "Accounts blocked by this user."
    },
    "/clips/{clipId}": {
      "schema": { "$ref": "#/entities/Clip" },
      "description": "Published short-form vertical clips."
    },
    "/clips/{clipId}/comments/{commentId}": {
      "schema": { "$ref": "#/entities/ClipComment" },
      "description": "Real-time comments attached to a Firestore clip."
    },
    "/starterComments/{commentId}": {
      "schema": { "$ref": "#/entities/ClipComment" },
      "description": "Real-time comments on curated Viroklipz showcase clips."
    },
    "/chats/{roomId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Real-time community chat rooms."
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "#/entities/ContentReport" },
      "description": "Write-only moderation reports submitted by verified users."
    },
    "/directThreads/{threadId}": {
      "schema": { "$ref": "#/entities/DirectThread" },
      "description": "1-to-1 direct message threads accessible strictly to both participants."
    },
    "/directThreads/{threadId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/DirectMessage" },
      "description": "Messages inside a direct thread, gated by parent participant membership."
    },
    "/statusNotes/{userId}": {
      "schema": { "$ref": "#/entities/StatusNote" },
      "description": "Short user status notes and availability states displayed in Mensajes."
    }
  }
}
