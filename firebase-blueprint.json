          "pattern": "^[a-z0-9._]{3,24}$"
        },
        "authorDisplayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "authorAvatarUrl": {
          "type": "string",
          "maxLength": 300
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "kind": {
          "type": "string",
          "enum": ["chat", "like", "gift"]
        },
        "giftName": {
          "type": "string",
          "maxLength": 40
        },
        "giftId": {
          "type": "string",
          "maxLength": 32
        },
        "giftValue": {
          "type": "number"
        },
        "senderFanLevel": {
          "type": "number"
        },
        "triggeredAction": {
          "type": "string",
          "maxLength": 80
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "streamId",
        "authorId",
        "authorUsername",
        "authorDisplayName",
        "authorAvatarUrl",
        "text",
        "kind",
        "createdAt"
      ]
    },
    "CreatorLiveConfig": {
      "title": "CreatorLiveConfig",
      "description": "Saved Fan Club perks, Fan Level settings, Audience Favorites, and Live VIP Alert preferences for a creator's Lives.",
      "type": "object",
      "properties": {
        "creatorUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fanPerks": {
          "type": "array"
        },
        "audienceFavorites": {
          "type": "array"
        },
        "fanClubName": {
          "type": "string",
          "maxLength": 36
        },
        "fanPointsPerCoin": {
          "type": "number"
        },
        "vipAlertEnabled": {
          "type": "boolean"
        },
        "vipAlertTitle": {
          "type": "string",
          "maxLength": 40
        },
        "vipAlertStyle": {
          "type": "string",
          "enum": ["crystal_magenta", "electric_pulse", "aurora_vip"]
        },
        "vipAlertDurationSec": {
          "type": "number"
        },
        "vipAlertSound": {
          "type": "boolean"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["creatorUid", "fanPerks", "audienceFavorites", "updatedAt"]
    }
  },
  "firestore": {
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminRole" },
      "description": "Server-managed administrator role records."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Public creator profiles without PII."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Private PII and user streak documents strictly accessible to owner."
    },
    "/users/{userId}/likes/{clipId}": {
      "schema": { "$ref": "#/entities/UserReaction" },
      "description": "Clips liked by this user."
    },
    "/users/{userId}/bookmarks/{clipId}": {
      "schema": { "$ref": "#/entities/UserReaction" },
      "description": "Clips saved/bookmarked by this user."
    },
    "/users/{userId}/following/{targetId}": {
      "schema": { "$ref": "#/entities/UserFollow" },
      "description": "Creators followed by this user."
    },
    "/users/{userId}/blocked/{targetId}": {
      "schema": { "$ref": "#/entities/UserBlock" },
      "description": "Accounts blocked by this user."
    },
    "/clips/{clipId}": {
      "schema": { "$ref": "#/entities/Clip" },
      "description": "Published short-form vertical clips."
    },
    "/clips/{clipId}/comments/{commentId}": {
      "schema": { "$ref": "#/entities/ClipComment" },
      "description": "Real-time comments attached to a Firestore clip."
    },
    "/starterComments/{commentId}": {
      "schema": { "$ref": "#/entities/ClipComment" },
      "description": "Real-time comments on curated Viroklipz showcase clips."
    },
    "/chats/{roomId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Real-time community chat rooms."
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "#/entities/ContentReport" },
      "description": "Moderation reports submitted by verified users and reviewed by owner/admin."
    },
    "/directThreads/{threadId}": {
      "schema": { "$ref": "#/entities/DirectThread" },
      "description": "1-to-1 direct message threads accessible strictly to both participants."
    },
    "/directThreads/{threadId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/DirectMessage" },
      "description": "Messages inside a direct thread, gated by parent participant membership."
    },
    "/statusNotes/{userId}": {
      "schema": { "$ref": "#/entities/StatusNote" },
      "description": "Short user status notes and availability states displayed in Mensajes."
    },
    "/community_chat/{messageId}": {
      "schema": { "$ref": "#/entities/CommunityChatMessage" },
      "description": "Global real-time community chat room messages."
    },
    "/liveStreams/{streamId}": {
      "schema": { "$ref": "#/entities/LiveStream" },
      "description": "Active and ended creator live broadcasts shown in Para ti and En vivo."
    },
    "/liveStreams/{streamId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/LiveStreamMessage" },
      "description": "Real-time chat, heart, and gift events inside an active live stream room."
    },
    "/liveConfigs/{creatorUid}": {
      "schema": { "$ref": "#/entities/CreatorLiveConfig" },
      "description": "Saved Fan Club perks and Audience Favorites per creator."
    }
  }
